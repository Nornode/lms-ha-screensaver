# Copy this file to .env.local (gitignored) and fill in your local values.
# NEVER commit .env.local or real IP addresses / tokens / passwords.

# Lyrion Music Server host & HTTP port (default 9000)
LMS_HOST=192.168.1.10
LMS_PORT=9000

# SSH target for the host running Lyrion Music Server (e.g. HA OS SSH add-on)
LMS_SSH_HOST=root@homeassistant.local

# LMS InstalledPlugins directory on the target host
# For pssc/ha-addon-lms on Home Assistant OS, this is typically:
LMS_PLUGINS_DIR=/config/lms/cache/InstalledPlugins/Plugins

# Optional: IP address of a single test Squeezebox Radio with Remote Login (SSH) enabled
RADIO_IP=192.168.1.20
RADIO_SSH_USER=root
